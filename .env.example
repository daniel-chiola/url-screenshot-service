# Copia questo file in ".env" e modifica i valori se ti servono default diversi
# da quelli del servizio (vedi tabella "Configurazione" nel README).
# Con Docker Compose, docker-compose.yml legge già valori validi per il container:
# queste variabili servono soprattutto per l'esecuzione in locale senza Docker.

# Dove vengono salvati gli screenshot
SCREENSHOTS_DIR=./screenshots

# Dove viene salvato il file SQLite dei job
DB_PATH=./data/jobs.db

# Quanti screenshot possono essere generati insieme
MAX_CONCURRENT_CAPTURES=2

# Quante richieste può fare un client per minuto (sintassi slowapi)
RATE_LIMIT=5/minute

# Se impostata, protegge gli endpoint con l'header X-API-Key. Vuota = nessuna autenticazione.
API_KEY=
